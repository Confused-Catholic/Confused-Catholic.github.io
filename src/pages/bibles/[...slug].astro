---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BiblePost from '../../layouts/BiblePost.astro';

export async function getStaticPaths() {
	const posts = await getCollection('bible');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'bible'>;

const post = Astro.props;
const { Content } = await render(post);
---

<BiblePost {...post.data}>
	<Content />
</BiblePost>
