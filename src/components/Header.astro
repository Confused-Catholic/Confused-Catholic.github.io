---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';

const isBible = Astro.url.pathname.startsWith("/bibles/");
const tocURL = `${Astro.url.pathname}#table-of-contents`;

---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/bibles">Bibles</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<HeaderLink href="/support">Support</HeaderLink>
		</div>
		
		<div class="toc-container">
			{
				isBible && 
					<HeaderLink href={tocURL}>Table of Contents</HeaderLink>				
			}
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background-color: rgb(230, 145, 145);
		position: sticky;
		top: 0;
		z-index: 100;
		width: 100%;
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		text-align: center;
		align-items: center;
		justify-content: space-between;
		padding-bottom: 2px;
		width: 100%;
	}
	nav a {
		padding: 1px 1px;
		align-items: center;
		justify-content: center;
		color: var(--black);
		border-bottom: 2px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}

	.toc-container {
		background-color: black;
		color: white;
		position: sticky;
	}
	
</style>
